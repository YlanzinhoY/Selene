{
  "schema_version": 1,
  "revision": "2026-08-18-2.8-lanzinho",
  "channel": "stable",
  "bundles": [
    {
      "id": "luatools",
      "name": "LuaTools for Linux",
      "description": "Main stack with slsteam-moon, Lumen, and the LuaTools plugin.",
      "components": [
        "slsteam-moon",
        "lumen",
        "luatools-moon"
      ]
    }
  ],
  "components": [
    {
      "id": "slsteam-moon",
      "name": "slsteam-moon",
      "version": "v2.8",
      "description": "Steam integration used to launch Lumen and LuaTools.",
      "dependencies": [],
      "source": {
        "provider": "github-release",
        "repository": "swwayps/slsteam-moon",
        "reference": "v2.8"
      },
      "artifact": {
        "name": "slsteam-moon-linux-2.8-lumen.zip",
        "url": "https://github.com/swwayps/slsteam-moon/releases/download/v2.8/slsteam-moon-linux-2.8-lumen.zip",
        "size": 4875826,
        "sha256": "dfe151119ad2783492c743d8f6386414b02a8aaef1ceb46579f18d1b054d6f18",
        "format": "zip"
      },
      "install": {
        "strategy": "verified-script",
        "destination": "${HOME}/.local/share/SLSsteam",
        "strip_components": 1,
        "entrypoint": "setup.sh",
        "arguments": [
          "install"
        ],
        "executables": [
          "ensure-desktop-coverage.sh",
          "bin/pattern-refresh"
        ],
        "validate": [
          "setup.sh",
          "bin/SLSsteam.so",
          "bin/library-inject.so",
          "res/config.yaml"
        ]
      }
    },
    {
      "id": "lumen",
      "name": "Lumen",
      "version": "v2.8",
      "description": "Sidecar that hosts the backend and injects the LuaTools frontend.",
      "dependencies": [
        "slsteam-moon"
      ],
      "source": {
        "provider": "github-release",
        "repository": "swwayps/lumen",
        "reference": "v2.8"
      },
      "artifact": {
        "name": "lumen-linux.zip",
        "url": "https://github.com/swwayps/lumen/releases/download/v2.8/lumen-linux.zip",
        "size": 2760173,
        "sha256": "6080547ec0116f9d5ad2c0ed70b0754f202be105e4cee73f6669645af9f90c7b",
        "format": "zip"
      },
      "install": {
        "strategy": "extract",
        "destination": "${HOME}/.local/share/Lumen",
        "strip_components": 0,
        "executables": [
          "lumen",
          "lua/restart_steam.sh"
        ],
        "validate": [
          "lumen",
          "lua/boot.lua",
          "lua/injector.lua"
        ]
      }
    },
    {
      "id": "luatools-moon",
      "name": "LuaTools Moon",
      "version": "2.8-lanzinho",
      "description": "LuaTools frontend and Lua backend for Lumen.",
      "dependencies": [
        "lumen"
      ],
      "source": {
        "provider": "github-release",
        "repository": "YlanzinhoY/luatools-moon",
        "reference": "2.8-lanzinho"
      },
      "artifact": {
        "name": "luatools-linux.zip",
        "url": "https://github.com/YlanzinhoY/luatools-moon/releases/download/2.8-lanzinho/luatools-linux.zip",
        "size": 4697676,
        "sha256": "fe1fa9f04df4b4ab65ba820213540b89b13e42994e457b500441e83dc0014643",
        "format": "zip"
      },
      "install": {
        "strategy": "replace-preserve",
        "destination": "${HOME}/.local/share/Lumen/luatools",
        "strip_components": 0,
        "preserve": [
          "backend/data"
        ],
        "executables": [
          "backend/bin/7zz"
        ],
        "validate": [
          "plugin.json",
          "backend/main.lua",
          "public/luatools.js"
        ]
      }
    },
    {
      "id": "cloudredirect-moon",
      "name": "CloudRedirect Moon",
      "version": "f07a3f59fec0",
      "description": "Optional cloud-save integration for the Moon ecosystem.",
      "optional": true,
      "dependencies": [
        "slsteam-moon",
        "lumen"
      ],
      "source": {
        "provider": "github-raw",
        "repository": "swwayps/cloudredirect-moon",
        "reference": "f07a3f59fec0e8bf086e8951e404f373c3bc8dd9"
      },
      "artifact": {
        "name": "cloud_redirect.so",
        "url": "https://raw.githubusercontent.com/swwayps/cloudredirect-moon/f07a3f59fec0e8bf086e8951e404f373c3bc8dd9/cloud_redirect.so",
        "size": 2053452,
        "sha256": "e31f3cd3714c2c9a1faf441a8787fb5678b3fc4a674dc8d8ddf3e85654a55cd4",
        "format": "file"
      },
      "install": {
        "strategy": "copy",
        "destination": "${HOME}/.local/share/CloudRedirect/cloud_redirect.so",
        "strip_components": 0,
        "validate": [
          "cloud_redirect.so"
        ]
      }
    }
  ]
}
