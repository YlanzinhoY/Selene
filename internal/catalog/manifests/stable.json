{
  "schema_version": 1,
  "revision": "2026-11-18-v2.9",
  "channel": "stable",
  "bundles": [
    {
      "id": "luatools",
      "name": "LuaTools for Linux",
      "description": "Main stack with slsteam-moon, Lumen, and the LuaTools plugin.",
      "components": [
        "slsteam-moon",
        "lumen",
        "luatools-moon"
      ]
    }
  ],
  "components": [
    {
      "id": "slsteam-moon",
      "name": "slsteam-moon",
      "version": "v2.9",
      "description": "Steam integration used to launch Lumen and LuaTools.",
      "dependencies": [],
      "source": {
        "provider": "github-release",
        "repository": "swwayps/slsteam-moon",
        "reference": "v2.9"
      },
      "artifact": {
        "name": "slsteam-moon-linux-2.9-lumen.zip",
        "url": "https://github.com/swwayps/slsteam-moon/releases/download/v2.9/slsteam-moon-linux-2.9-lumen.zip",
        "size": 5023592,
        "sha256": "c05d2328c9902673295cd76c2e299dc853ab760fd470d67d15377e5c10995c72",
        "format": "zip"
      },
      "install": {
        "strategy": "verified-script",
        "destination": "${HOME}/.local/share/SLSsteam",
        "strip_components": 1,
        "entrypoint": "setup.sh",
        "arguments": [
          "install"
        ],
        "executables": [
          "ensure-desktop-coverage.sh",
          "bin/pattern-refresh"
        ],
        "validate": [
          "setup.sh",
          "bin/SLSsteam.so",
          "bin/library-inject.so",
          "res/config.yaml"
        ]
      }
    },
    {
      "id": "lumen",
      "name": "Lumen",
      "version": "v2.9",
      "description": "Sidecar that hosts the backend and injects the LuaTools frontend.",
      "dependencies": [
        "slsteam-moon"
      ],
      "source": {
        "provider": "github-release",
        "repository": "swwayps/lumen",
        "reference": "v2.9"
      },
      "artifact": {
        "name": "lumen-linux.zip",
        "url": "https://github.com/swwayps/lumen/releases/download/v2.9/lumen-linux.zip",
        "size": 2834287,
        "sha256": "7aa0cb7fb6a6ddc73b8d548de3f4f0d58d36d158be0ca8fe32370dd10e41daa7",
        "format": "zip"
      },
      "install": {
        "strategy": "extract",
        "destination": "${HOME}/.local/share/Lumen",
        "strip_components": 0,
        "executables": [
          "lumen",
          "lua/restart_steam.sh"
        ],
        "validate": [
          "lumen",
          "lua/boot.lua",
          "lua/injector.lua"
        ]
      }
    },
    {
      "id": "luatools-moon",
      "name": "LuaTools Moon",
      "version": "v2.9",
      "description": "LuaTools frontend and Lua backend for Lumen.",
      "dependencies": [
        "lumen"
      ],
      "source": {
        "provider": "github-release",
        "repository": "swwayps/luatools-moon",
        "reference": "v2.9"
      },
      "artifact": {
        "name": "luatools-linux.zip",
        "url": "https://github.com/swwayps/luatools-moon/releases/download/v2.9/luatools-linux.zip",
        "size": 2052629,
        "sha256": "f4ddb67c66be66108834885634767cf69e7cf542aa7c121ea17f61d1fefc4dae",
        "format": "zip"
      },
      "install": {
        "strategy": "replace-preserve",
        "destination": "${HOME}/.local/share/Lumen/luatools",
        "strip_components": 0,
        "preserve": [
          "backend/data"
        ],
        "executables": [
          "backend/bin/7zz"
        ],
        "validate": [
          "plugin.json",
          "backend/main.lua",
          "public/luatools.js"
        ]
      }
    },
    {
      "id": "cloudredirect-moon",
      "name": "CloudRedirect Moon",
      "version": "f07a3f59fec0",
      "description": "Optional cloud-save integration for the Moon ecosystem.",
      "optional": true,
      "dependencies": [
        "slsteam-moon",
        "lumen"
      ],
      "source": {
        "provider": "github-raw",
        "repository": "swwayps/cloudredirect-moon",
        "reference": "f07a3f59fec0e8bf086e8951e404f373c3bc8dd9"
      },
      "artifact": {
        "name": "cloud_redirect.so",
        "url": "https://raw.githubusercontent.com/swwayps/cloudredirect-moon/f07a3f59fec0e8bf086e8951e404f373c3bc8dd9/cloud_redirect.so",
        "size": 2053452,
        "sha256": "e31f3cd3714c2c9a1faf441a8787fb5678b3fc4a674dc8d8ddf3e85654a55cd4",
        "format": "file"
      },
      "install": {
        "strategy": "copy",
        "destination": "${HOME}/.local/share/CloudRedirect/cloud_redirect.so",
        "strip_components": 0,
        "validate": [
          "cloud_redirect.so"
        ]
      }
    }
  ]
}
